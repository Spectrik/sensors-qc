{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "input",
    "output",
    "job",
    "resources",
    "scratch"
  ],
  "properties": {
    "input": {
      "type": "object",
      "required": [
        "mode",
        "existingClaim",
        "file"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "sample",
            "pvc"
          ]
        },
        "existingClaim": {
          "type": "string",
          "maxLength": 253
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "mode",
        "existingClaim",
        "file"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "stdout",
            "pvc"
          ]
        },
        "existingClaim": {
          "type": "string",
          "maxLength": 253
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "job": {
      "type": "object",
      "required": [
        "backoffLimit",
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished"
      ],
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scratch": {
      "type": "object",
      "required": [
        "sizeLimit"
      ],
      "properties": {
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
